---
import Base from '../../layouts/Base.astro';
import { pieces, pieceFile, url } from '../../lib/site';
const all = pieces();
const editions = all.reduce((count, piece) => count + piece.editions.length, 0);
---
<Base title="範例曲目" description="HarpScore 製作的口琴編曲與記譜版本，每份附實際第一頁預覽與可編輯檔。" current="pieces">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">HarpScore pieces</p>
      <h1>範例曲目</h1>
      <p class="lead">由 HarpScore 製作的口琴編曲與重製版本。每份版本都有自己的第一頁預覽與可編輯樂譜；編曲候選及尚待聽奏驗收的狀態分別標示。</p>
      <p class="muted">{all.length} 首曲目 · {editions} 個版本。製作新曲的方法見<a href={url('docs/guide/starting-a-piece/')}>選擇編制與記譜版式</a>。</p>
      <label class="piece-search">找一首曲子<input type="search" id="piece-search" placeholder="搜尋曲名、作曲家、五線譜或簡譜" /></label>
      <p id="piece-count" role="status" aria-live="polite">顯示 {all.length} 首曲目</p>
    </header>
    <div class="grid">
      {all.map(piece => {
        const cover = piece.editions.find(e => e.notation === 'numbered' && e.image) ?? piece.editions.find(e => e.image);
        return <a class="card piece" href={url(`pieces/${piece.id}/`)} data-piece data-search={[piece.title, piece.composer, ...piece.editions.map(e => `${e.label} ${e.notation === 'numbered' ? '簡譜' : '五線譜'}`)].join(' ').toLocaleLowerCase()}>
          {cover && <div class="score"><img src={pieceFile(piece, cover.image!)} alt={`${piece.title}・${cover.label}第一頁`} loading="lazy" width="1000" height="1414" /></div>}
          <h2>{piece.title}</h2>
          <p>{piece.composer} · {piece.editions.length} 個版本{piece.bars && ` · ${piece.bars} 小節`}</p>
          {piece.summary && <p class="summary">{piece.summary}</p>}
          <span class="open">查看版本與下載 →</span>
        </a>;
      })}
    </div>
    <p id="piece-empty" hidden>沒有符合的曲目，請試試其他關鍵字。</p>
    <p class="collection-note muted">只收錄有 HarpScore 製作紀錄的版本，不收原始來源譜與單純匯入檔。樂譜授權與網站程式的 MIT 授權分開；原曲及第三方編曲權利屬各權利人，個別授權範圍待補。</p>
  </div>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#piece-search')!;
  input.addEventListener('input', () => {
    const terms = input.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-piece]').forEach(card => {
      card.hidden = !terms.every(term => card.dataset.search!.includes(term));
      if (!card.hidden) count++;
    });
    document.querySelector('#piece-count')!.textContent = `顯示 ${count} 首曲目`;
    (document.querySelector('#piece-empty') as HTMLElement).hidden = count > 0;
  });
</script>
<style>
  .grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .piece { display: flex; flex-direction: column; }
  .piece[hidden] { display: none; }
  .piece .score { aspect-ratio: 210 / 297; margin-bottom: 1rem; }
  .piece .score img { object-fit: contain; object-position: top; width: 100%; height: 100%; }
  .piece h2 { margin: 0 0 .4rem; font-size: 1.25rem; overflow-wrap: anywhere; }
  .piece .summary { font-size: .85rem; }
  .open { color: var(--accent); margin-top: auto; padding-top: 1rem; font-size: .9rem; }
  .piece-search { display: grid; gap: .4rem; max-width: 35rem; margin-top: 1.5rem; }
  input { font: inherit; padding: .7rem; border: 1px solid var(--line); border-radius: 6px; background: white; color: var(--ink); width: 100%; }
  .collection-note { margin-top: 2.5rem; font-size: .9rem; max-width: 58rem; }
</style>
