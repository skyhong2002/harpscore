  "principles": [
    "Pickup and the phrase it launches always have the same owner.",
    "A-theme exchanges follow its initial syncopated cell and cadential answering cell; no modulo-four handoff.",
    "B and D retain eight-bar periods; a B-theme lead change includes its preceding E-F-F# anacrusis.",
    "The independent C-theme inner voice comes from the original upper staff.",
    "Other counterlines reduce original LH members and harmonic bass approaches into a moving wind voice; not a sustained guide tone or a copied ensemble score.",
    "Keep accompaniment quieter than melody and leave breathing at cadence endings."
  ],
  "reference_observations": [
    {
      "url": "https://www.prattmusic.com/brass/Entertainer%20-%20Septet%20Preview.pdf",
      "use": "Phrase/texture study only: lead exchange at a melodic continuation while other voices retain accompaniment. No notes copied."
    },
    {
      "url": "https://lincolnmusicpublications.com/_assets/first_page/SAQ4/classical/Joplin_The_Entertainer_SQ4.pdf",
      "use": "Texture study only: active inner voices and phrase ownership; no arrangement notes copied."
    }
  ],
