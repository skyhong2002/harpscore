{
  "id": "skyhong",
  "inherits": "fixed-c",
  "scope": "founding user preferences; opt in, not universal",
  "arranger": "skyhong.tw",
  "beginner_level_months": 2,
  "chromatic_clefs": {
    "allowed": [
      "treble",
      "treble-8-below"
    ],
    "bass_clef": false,
    "switch_by_register": true,
    "preserve_sounding_pitch": true,
    "scope": "chromatic harmonica only; not Double Bass or Jianpu octave reference"
  },
  "duet_handoffs": "complete-musical-phrases",
  "bass": {
    "sustain_into_unnecessary_rests": true,
    "preserve_groove": true,
    "force_two_or_four_beats": false
  },
  "chord": {
    "staff_notation": "single-line-rhythm; preserve source notehead conventions when re-engraving",
    "staccato_dots": false,
    "symbols_at": [
      "bar-start",
      "harmonic-change-onset"
    ],
    "symbol_lane": {
      "staff": "above-chord-close-to-rhythm",
      "jianpu": "below-chord-close-to-rhythm"
    },
    "dynamics_lane": "below-chord",
    "key_signature": false,
    "stem_direction": "down",
    "playback_model": {
      "scope": "user-confirmed Suzuki voicings; confirm other instruments separately",
      "physical_positions": 4,
      "octave_reeds_per_position": 2,
      "preserve_duplicate_unisons": true,
      "unpointed_one": "C5",
      "C_lowest_reed": "E3",
      "voicing_source": "user-supplied Suzuki chart; preserve inversions"
    }
  },
  "editions": {
    "staff": [
      "solo",
      "solo-piano",
      "duet-combined",
      "duet-piano",
      "quintet"
    ],
    "jianpu": [
      "solo",
      "duet-combined",
      "quintet"
    ],
    "individual_harmonica_parts": false
  },
  "jianpu_first_edition": "1.0",
  "export_policy": "record per task; local MuseScore work, PDF/audio exports and cloud delivery are independent phases",
  "references": [
    "docs/preferences.md",
    "docs/conversation-decisions.md",
    "docs/musescore-adapter.md"
  ],
  "double_stops": {
    "use": "selective; check instrumentation and player level",
    "check": [
      "same-breath",
      "same-slide-state",
      "hole-span",
      "tongue-blocking"
    ],
    "numbered_size_relative_to_single": 0.75,
    "vertical_alignment": "pair-centre-on-single-note-centre",
    "expand_staff_spacing": false,
    "staff_octaves": "write-both-notes",
    "numbered_octaves": "single-numeral-with-circled-8-dashed-range",
    "preserve_both_performed_pitches": true,
    "non_octave_connections": "separate-shallow-upper-arcs-close-to-digits"
  },
  "instrument_ranges": {
    "scope": "user-confirmed sounding ranges; not all harmonicas",
    "chromatic": {
      "low": "C3",
      "high": "D7"
    },
    "double_bass": {
      "low": "E1",
      "high": "G4"
    }
  },
  "numbered_octave_doubling": {
    "anchor": "lower-performed-pitch",
    "symbol": "⑧",
    "range": "dashed-with-end-hooks",
    "placement": "above-own-numerals",
    "meaning": "add-upper-octave",
    "preserve_performed_pitches": true
  },
  "numbered_transposing_ottava_visible": false,
  "measure_numbers": "system-start-only",
  "connections": {
    "placement": "above-own-numerals",
    "shape": "shallow-arch-centre-above-both-ends",
    "reject": [
      "bowl-shaped",
      "inflected",
      "excessive-rise",
      "contact-with-numerals-or-marks"
    ],
    "preserve_native_endpoints_and_playback": true,
    "scope": "founding user preference; supersedes earlier upper/lower split"
  },
  "page_system_consistency": {
    "ordinary_full_pages": "same system count within an edition",
    "target": "choose by instrumentation and notation",
    "bars_per_system": "vary with attack density",
    "exceptions": [
      "title page",
      "incomplete final page",
      "unusual notation requiring extra space, verified in rendering"
    ],
    "verification": "V21: record actual system starts and reasons for exceptions"
  }
}
